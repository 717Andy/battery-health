<Page
    x:Class="BatteryHealth.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Battery lifecycle" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.Workspace.SummaryLine, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}" Opacity="0.8" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Open NASA JSON / CALCE file" Click="OnOpenFile" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="Load B0005 demo" Click="OnLoadDemo"/>
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.Workspace.Status, Mode=OneWay}"
                       Opacity="0.75"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16"
                Visibility="{x:Bind ViewModel.IntakeVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.IntakeText, Mode=OneWay}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.CycleCaption, Mode=OneWay}" Margin="0,0,0,8"/>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{x:Bind ViewModel.SensorSeries, Mode=OneWay}"
                                        XAxes="{x:Bind ViewModel.TimeAxis}"
                                        YAxes="{x:Bind ViewModel.SensorYAxis}"
                                        LegendPosition="Bottom"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="Discharge cycles" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.DischargeRows, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedRowIndex, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          MaxHeight="280"/>
                <NumberBox Header="Rated capacity (Ah)"
                           Minimum="0.1" Maximum="20" SmallChange="0.1"
                           SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.RatedAh, Mode=TwoWay}"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                           Text="Each row is one discharge. The nameplate sets measured SoH and both end-of-life lines. The SoH model stays the NASA 2.0 Ah fit."/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Capacity / SoH fade across cycles" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{x:Bind ViewModel.FadeSeries, Mode=OneWay}"
                                    XAxes="{x:Bind ViewModel.CycleAxis}"
                                    YAxes="{x:Bind ViewModel.CapacityAxis}"
                                    LegendPosition="Bottom"/>
            </Grid>
        </Border>
    </Grid>
</Page>
