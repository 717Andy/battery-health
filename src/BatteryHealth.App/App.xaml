<Application
    x:Class="BatteryHealth.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="HealthAccentBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="HealthWarnBrush" Color="#C2410C" />
            <SolidColorBrush x:Key="HealthGoodBrush" Color="#15803D" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
